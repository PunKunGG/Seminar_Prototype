# Supabase Auth (both values are required to enable login)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
CLASSMOOD_REQUIRE_AUTH=true

# Set to true only when ClassMood is served over HTTPS.
CLASSMOOD_SESSION_COOKIE_SECURE=false

# Optional: omit this locally to use backend/data/session_secret automatically.
# Deployments should provide a stable random value of at least 32 characters.
# CLASSMOOD_SESSION_SECRET=replace-with-a-long-random-value

# Real-time AI inference and anonymous position tracking
# CLASSMOOD_ANNOTATED_STREAM_FPS=5
# CLASSMOOD_CONTEXT_DETECTION_ENABLED=true
# CLASSMOOD_CONTEXT_DETECTION_INTERVAL=5
# CLASSMOOD_CONTEXT_DETECTION_CONFIDENCE=0.20
# CLASSMOOD_CONTEXT_DETECTION_IMAGE_SIZE=960
# CLASSMOOD_TRACK_MAX_MISSING_SECONDS=4
# CLASSMOOD_TRACK_POSITION_ENABLED=true
# CLASSMOOD_TRACK_POSITION_MEMORY_SECONDS=21600
# CLASSMOOD_TRACK_POSITION_MAX_DISTANCE=0.45
