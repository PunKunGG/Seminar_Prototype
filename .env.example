# Supabase Auth (both values are required to enable login)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
CLASSMOOD_REQUIRE_AUTH=true

# Set to true only when ClassMood is served over HTTPS.
CLASSMOOD_SESSION_COOKIE_SECURE=false

# Optional: omit this locally to use backend/data/session_secret automatically.
# Deployments should provide a stable random value of at least 32 characters.
# CLASSMOOD_SESSION_SECRET=replace-with-a-long-random-value
